const motor = new MotorJuego();

document.getElementById("btn-empezar").onclick = () => {
    document.getElementById("pantalla-inicio").style.display = "none";
    document.getElementById("hud-juego").style.display = "block";
    document.getElementById("panel-palabras").style.display = "flex";
    motor.jugador.agregarAEscena(motor.escena);
    motor.iniciar();
};

function normalizarPalabra(palabra) {
    return palabra.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
}

document.getElementById("btn-crear").onclick = () => {
    const entrada = document.getElementById("dict-input").value;
    const palabra = normalizarPalabra(entrada);
    console.log("Palabra:", palabra);
    document.getElementById("dict-input").value = "";
};

window.onkeydown = e => { motor.teclas[e.key.toLowerCase()] = true; };
window.onkeyup = e => { motor.teclas[e.key.toLowerCase()] = false; };
window.onmousemove = e => {
    if (!motor.angCam) return;
    motor.angCam.y += e.movementX * 0.002;
    motor.angCam.x -= e.movementY * 0.002;
};
document.body.onclick = () => document.body.requestPointerLock?.();

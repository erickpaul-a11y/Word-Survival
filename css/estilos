* { margin:0; padding:0; box-sizing:border-box; font-family:system-ui; user-select:none; }
body { background:#020617; color:#e2e8f0; height:100vh; overflow:hidden; }
#pantalla-inicio { position:fixed; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24px; z-index:9999; }
h1 { font-size:4rem; color:#38bdf8; text-shadow:0 0 30px #38bdf8; }
.btn-principal { padding:16px 42px; font-size:1.25rem; border:none; border-radius:12px; background:#38bdf8; color:white; cursor:pointer; font-weight:bold; }
.hud-caja { position:fixed; top:16px; left:16px; background:rgba(8,12,24,0.95); border:1px solid #1e293b; padding:12px 16px; border-radius:12px; font-size:0.9rem; backdrop-filter:blur(12px); }
.barra { height:10px; background:#0f172a; border-radius:6px; overflow:hidden; margin:5px 0; }
.barra>div { height:100%; transition:0.25s; }
.hp { background:#ef4444; } .mana { background:#a855f7; } .exp { background:#38bdf8; } .hambre { background:#f59e0b; }
#panel-palabras { position:fixed; bottom:24px; left:24px; right:24px; background:rgba(8,12,24,0.97); border-radius:16px; padding:16px; gap:14px; display:flex; z-index:150; backdrop-filter:blur(12px); }
#dict-input { flex:1; background:#0f172a; border:1px solid #1e293b; color:white; padding:14px; border-radius:12px; font-size:1rem; outline:none; }
.btn { padding:14px 20px; border-radius:12px; border:none; background:#38bdf8; color:white; cursor:pointer; font-weight:bold; }
